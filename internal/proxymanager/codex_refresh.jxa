ObjC.import('AppKit');
ObjC.import('Foundation');

function run() {
  const applications = $.NSWorkspace.sharedWorkspace.runningApplications;
  const matches = [];
  for (let index = 0; index < applications.count; index++) {
    const app = applications.objectAtIndex(index);
    const identifier = ObjC.unwrap(app.bundleIdentifier) || '';
    if (identifier.indexOf('com.openai.codex') === 0 && app.activationPolicy === $.NSApplicationActivationPolicyRegular) {
      matches.push(app);
    }
  }
  if (matches.length === 0) return;
  if (matches.length !== 1) throw new Error('Multiple Codex apps are running; restart the intended app to refresh its models.');
  const app = matches[0];
  const path = ObjC.unwrap(app.bundleURL.path);
  if (!app.terminate) throw new Error('Codex declined to quit; restart it to refresh its models.');
  const deadline = Date.now() + 15000;
  while (!app.isTerminated && Date.now() < deadline) $.NSThread.sleepForTimeInterval(0.1);
  if (!app.isTerminated) throw new Error('Codex is still running; finish its pending work and restart it to refresh its models.');
  const task = $.NSTask.alloc.init;
  task.launchPath = $('/usr/bin/open');
  task.arguments = $(['-a', path]);
  task.launch;
  task.waitUntilExit;
  if (task.terminationStatus !== 0) throw new Error('Codex was closed but could not be reopened; open it normally to load the new models.');
}
